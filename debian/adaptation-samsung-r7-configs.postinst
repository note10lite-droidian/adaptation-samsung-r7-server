#!/bin/sh
set -e

# r7: distribute the PulseAudio configuration to existing users.
#
# WHY THIS IS NEEDED: PA only reads ~/.config/pulse/default.pa and
# /etc/pulse/default.pa. The latter is diverted by pulseaudio-config-droid, so
# we cannot claim it. /etc/skel does not help either: during rootfs generation
# the user is created (device.yaml -> droidian_phosh.yaml -> gsi_base ->
# setup-user.sh) BEFORE this package is unpacked (device.yaml lines 16-18 vs
# 28-30), so skel is never applied.
#
# The system-wide /etc/pulse/arm_droid_card_custom.pa include point is not
# usable either: the stock default.pa loads module-droid-hidl AFTER that
# include, and that module expects module_id=primary, so it fails with
# "Couldn't get hw module functions" and takes PA down on a dbus assertion.

SRC=/etc/skel/.config/pulse/default.pa

if [ "$1" = "configure" ] && [ -f "$SRC" ]; then
    for home in /home/*; do
        [ -d "$home" ] || continue
        user="$(basename "$home")"
        id "$user" >/dev/null 2>&1 || continue

        dest="$home/.config/pulse/default.pa"
        # If the user created their own file, LEAVE IT ALONE
        if [ ! -e "$dest" ]; then
            mkdir -p "$home/.config/pulse"
            cp "$SRC" "$dest"
            chown -R "$user":"$(id -gn "$user")" "$home/.config/pulse"
        fi
    done
fi

# r7: camera backend. droidian-camera defaults to "aal", which is broken on
# this device; "gst" works. The file is a CONFFILE of the droidian-camera
# package, so it cannot be shipped via sparse/ (dpkg would fail with "trying
# to overwrite"); patch it in place instead.
CAMCONF=/etc/droidian-camera.conf
if [ "$1" = "configure" ] && [ -f "$CAMCONF" ]; then
    if grep -q '^backend=aal' "$CAMCONF"; then
        sed -i 's/^backend=aal/backend=gst/' "$CAMCONF"
    fi
fi

# r7: compile the S-Pen (sec_e-pen) hwdb quirk. sparse/etc/udev/hwdb.d/61-sec-epen.hwdb
# gives ABS_X/ABS_Y a resolution (libinput otherwise rejects the pen). The
# hwdb.bin MUST be regenerated or the quirk never takes effect. Idempotent.
if [ "$1" = "configure" ] && command -v systemd-hwdb >/dev/null 2>&1; then
    systemd-hwdb update || true
fi

# r7: S-Pen mode daemon (tablet/touch toggle). Compile the GSettings schema and
# enable the user service for all users. The schema is shipped via sparse under
# /usr/share/glib-2.0/schemas/; the toggle (phosh-mobile-settings) and the daemon
# read the same schema.
if [ "$1" = "configure" ]; then
    if command -v glib-compile-schemas >/dev/null 2>&1; then
        glib-compile-schemas /usr/share/glib-2.0/schemas/ || true
    fi
    if command -v systemctl >/dev/null 2>&1; then
        systemctl --global enable r7-spen-mode.service || true
    fi
fi

# r7: repoint /etc/resolv.conf at NetworkManager's resolv.conf.
#
# WHY: the rootfs ships /etc/resolv.conf as a symlink to the systemd-resolved
# stub (../run/systemd/resolve/stub-resolv.conf). systemd-resolved is MASKED on
# this device, so that stub file is never created -> /etc/resolv.conf is a
# DANGLING symlink and DNS fails completely (WiFi connects and 8.8.8.8 pings,
# but no name resolves). 90-dns-no-stub.conf already tells NetworkManager to
# write /run/NetworkManager/resolv.conf (dns=default, rc-manager=symlink), and
# it does — but NetworkManager will NOT overwrite a pre-existing /etc/resolv.conf
# symlink that points elsewhere, so it never repoints it. Force it here.
#
# This ships no static nameserver: it points at NM's own dynamically written
# file (cf. the earlier removal of a hardcoded resolv.conf). The target may not
# exist yet at unpack time; the symlink resolves once NM writes it on first boot.
if [ "$1" = "configure" ]; then
    ln -sf /run/NetworkManager/resolv.conf /etc/resolv.conf || true
fi

#DEBHELPER#

exit 0
