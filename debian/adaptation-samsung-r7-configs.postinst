#!/bin/sh
set -e

# r7: PulseAudio yapilandirmasini mevcut kullanicilara dagit.
#
# NEDEN GEREKLI: PA yalnizca ~/.config/pulse/default.pa ve /etc/pulse/default.pa
# okur. Ikincisi pulseaudio-config-droid tarafindan divert edilmis durumda, yani
# sahiplenemiyoruz. /etc/skel ise ise yaramiyor: rootfs uretiminde kullanici
# (device.yaml -> droidian_phosh.yaml -> gsi_base -> setup-user.sh) BU PAKETTEN
# ONCE olusuyor (device.yaml satir 16-18 vs 28-30), dolayisiyla skel uygulanmiyor.
#
# Sistem genelindeki /etc/pulse/arm_droid_card_custom.pa include noktasi da
# kullanilamiyor: stok default.pa o include'dan SONRA module-droid-hidl yukluyor,
# o da module_id=primary bekledigi icin "Couldn't get hw module functions" verip
# PA'yi dbus assertion'inda cokertiyor.

SRC=/etc/skel/.config/pulse/default.pa

if [ "$1" = "configure" ] && [ -f "$SRC" ]; then
    for home in /home/*; do
        [ -d "$home" ] || continue
        user="$(basename "$home")"
        id "$user" >/dev/null 2>&1 || continue

        dest="$home/.config/pulse/default.pa"
        # Kullanici kendi dosyasini olusturmussa DOKUNMA
        if [ ! -e "$dest" ]; then
            mkdir -p "$home/.config/pulse"
            cp "$SRC" "$dest"
            chown -R "$user":"$(id -gn "$user")" "$home/.config/pulse"
        fi
    done
fi

# r7: Kamera backend'i. droidian-camera'nin varsayilani "aal" bu cihazda bozuk;
# "gst" calisiyor. Dosya droidian-camera paketinin CONFFILE'i oldugu icin
# sparse/ ile gonderilemez (dpkg "trying to overwrite" hatasi verir), bu yuzden
# burada yerinde degistiriliyor.
CAMCONF=/etc/droidian-camera.conf
if [ "$1" = "configure" ] && [ -f "$CAMCONF" ]; then
    if grep -q '^backend=aal' "$CAMCONF"; then
        sed -i 's/^backend=aal/backend=gst/' "$CAMCONF"
    fi
fi

#DEBHELPER#

exit 0
