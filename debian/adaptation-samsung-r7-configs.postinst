#!/bin/sh
set -e

# r7: distribute the PulseAudio configuration to existing users.
#
# WHY THIS IS NEEDED: PA only reads ~/.config/pulse/default.pa and
# /etc/pulse/default.pa. The latter is diverted by pulseaudio-config-droid, so
# we cannot claim it. /etc/skel does not help either: during rootfs generation
# the user is created (device.yaml -> droidian_phosh.yaml -> gsi_base ->
# setup-user.sh) BEFORE this package is unpacked (device.yaml lines 16-18 vs
# 28-30), so skel is never applied.
#
# The system-wide /etc/pulse/arm_droid_card_custom.pa include point is not
# usable either: the stock default.pa loads module-droid-hidl AFTER that
# include, and that module expects module_id=primary, so it fails with
# "Couldn't get hw module functions" and takes PA down on a dbus assertion.

SRC=/etc/skel/.config/pulse/default.pa

if [ "$1" = "configure" ] && [ -f "$SRC" ]; then
    for home in /home/*; do
        [ -d "$home" ] || continue
        user="$(basename "$home")"
        id "$user" >/dev/null 2>&1 || continue

        dest="$home/.config/pulse/default.pa"
        # If the user created their own file, LEAVE IT ALONE
        if [ ! -e "$dest" ]; then
            mkdir -p "$home/.config/pulse"
            cp "$SRC" "$dest"
            chown -R "$user":"$(id -gn "$user")" "$home/.config/pulse"
        fi
    done
fi

# r7-server: distribute waybar + foot config the same way, and for the
# exact same reason as default.pa above (/etc/skel never applies - the user
# already exists by the time this package unpacks). phoc itself needs no
# per-user config distribution (unlike wayfire.ini before it) -
# phoc-console.service passes the stock /usr/share/phosh/phoc.ini directly
# via -C, already confirmed live to produce a correct upright portrait
# console unmodified.
if [ "$1" = "configure" ]; then
    for home in /home/*; do
        [ -d "$home" ] || continue
        user="$(basename "$home")"
        id "$user" >/dev/null 2>&1 || continue

        for rel in waybar/config waybar/style.css foot/foot.ini; do
            src="/etc/skel/.config/$rel"
            dest="$home/.config/$rel"
            [ -f "$src" ] || continue
            # If the user customised it, LEAVE IT ALONE
            if [ ! -e "$dest" ]; then
                mkdir -p "$(dirname "$dest")"
                cp "$src" "$dest"
                chown -R "$user":"$(id -gn "$user")" "$home/.config"
            fi
        done
    done
fi

# r7: camera backend. droidian-camera defaults to "aal", which is broken on
# this device; "gst" works. The file is a CONFFILE of the droidian-camera
# package, so it cannot be shipped via sparse/ (dpkg would fail with "trying
# to overwrite"); patch it in place instead.
CAMCONF=/etc/droidian-camera.conf
if [ "$1" = "configure" ] && [ -f "$CAMCONF" ]; then
    if grep -q '^backend=aal' "$CAMCONF"; then
        sed -i 's/^backend=aal/backend=gst/' "$CAMCONF"
    fi
fi

# r7: compile the S-Pen (sec_e-pen) hwdb quirk. sparse/etc/udev/hwdb.d/61-sec-epen.hwdb
# gives ABS_X/ABS_Y a resolution (libinput otherwise rejects the pen). The
# hwdb.bin MUST be regenerated or the quirk never takes effect. Idempotent.
if [ "$1" = "configure" ] && command -v systemd-hwdb >/dev/null 2>&1; then
    systemd-hwdb update || true
fi

# r7: S-Pen mode daemon (tablet/touch toggle). Compile the GSettings schema and
# enable the user service for all users. The schema is shipped via sparse under
# /usr/share/glib-2.0/schemas/; the toggle (phosh-mobile-settings) and the daemon
# read the same schema.
if [ "$1" = "configure" ]; then
    if command -v glib-compile-schemas >/dev/null 2>&1; then
        glib-compile-schemas /usr/share/glib-2.0/schemas/ || true
    fi
    if command -v systemctl >/dev/null 2>&1; then
        systemctl --global enable r7-spen-mode.service || true
    fi
fi

# r7: audio sink volume persistence. Stock PulseAudio's module-stream-restore
# only subscribes to PA_SUBSCRIPTION_MASK_SINK_INPUT|SOURCE_OUTPUT (checked
# against the actual v14.2 source) - it never tracks a sink's own device
# volume, only per-application stream volumes, so the volume phosh's slider
# sets falls back to the droid-sink's Base Volume (100%) on every PulseAudio
# restart/reboot. r7-volume-save watches `pactl subscribe` and persists sink
# volume changes; r7-volume-restore applies the saved value (or a 70% default)
# at PulseAudio startup. Proven live 2026-08-08 across two full
# change/restart/verify cycles (GUNLUK G1.36).
if [ "$1" = "configure" ] && command -v systemctl >/dev/null 2>&1; then
    systemctl --global enable r7-volume-save.service r7-volume-restore.service || true
fi

# r7-server: first-boot setup lock (OOBE) — DISABLED, not enabled.
#
# Inherited from the phone image, where it holds a wlr-layer-shell overlay
# until readiness probes pass. Checked its probe list for this fork
# (usr/libexec/r7-setup-lock): it gates on iio-sensor-proxy and
# android-audio-hal being active — both stripped from this image entirely.
# Left enabled, this would block the console behind an overlay waiting on
# probes that can never pass — a permanent lockout, not a cosmetic issue.
# There's no OOBE concept for this image at all (no gnome-initial-setup,
# no per-user first-login flow), so disable both units outright rather than
# trying to patch its probe list.
if [ "$1" = "configure" ] && command -v systemctl >/dev/null 2>&1; then
    systemctl --global disable r7-setup-lock.path 2>/dev/null || true
    systemctl --global disable r7-setup-lock.service 2>/dev/null || true
fi

# r7-server: phoc-console becomes the default (only) session, not an opt-in
# alternative to phosh — phosh is gone entirely from this image (Conflicts
# in debian/control). phoc-console.service models its seat/VT setup on
# phosh.service (see adaptation-samsung-r7-desktop's Depends + the unit
# file's own notes on why phoc replaced wayfire here); enable it directly so
# it's what comes up on tty7 at boot, same role phosh.service used to have.
if [ "$1" = "configure" ] && command -v systemctl >/dev/null 2>&1; then
    systemctl enable phoc-console.service || true
fi

# r7: repoint /etc/resolv.conf at NetworkManager's resolv.conf.
#
# WHY: the rootfs ships /etc/resolv.conf as a symlink to the systemd-resolved
# stub (../run/systemd/resolve/stub-resolv.conf). systemd-resolved is MASKED on
# this device, so that stub file is never created -> /etc/resolv.conf is a
# DANGLING symlink and DNS fails completely (WiFi connects and 8.8.8.8 pings,
# but no name resolves). 90-dns-no-stub.conf already tells NetworkManager to
# write /run/NetworkManager/resolv.conf (dns=default, rc-manager=symlink), and
# it does — but NetworkManager will NOT overwrite a pre-existing /etc/resolv.conf
# symlink that points elsewhere, so it never repoints it. Force it here.
#
# This ships no static nameserver: it points at NM's own dynamically written
# file (cf. the earlier removal of a hardcoded resolv.conf). The target may not
# exist yet at unpack time; the symlink resolves once NM writes it on first boot.
if [ "$1" = "configure" ]; then
    ln -sf /run/NetworkManager/resolv.conf /etc/resolv.conf || true
fi

# r7: USB RNDIS networking was completely non-functional. mtp-server's
# mtp-configfs script (which runs automatically at every boot via
# mtp-configfs@rndis.service, see android_boot_completed.service) bails out
# immediately - regardless of requested mode - unless
# /usr/lib/droidian/device/mtp-supported exists; nothing shipped it. Once
# unblocked, the script also invokes /usr/sbin/dhcpd directly (not via the
# isc-dhcp-server package's own service - that one stays unused/disabled
# below) to serve an IP on the gadget interface, using
# /etc/hybris-usb/dhcpd.conf. Both files now ship in this package (see the
# isc-dhcp-server Depends in control). Proven live end-to-end 2026-08-08
# (RNDIS up, DHCP lease handed out, SSH over USB) - GUNLUK G1.30.
#
# The isc-dhcp-server package's own generic isc-dhcp-server.service tries to
# start against /etc/dhcp/dhcpd.conf (no interface configured there) and
# fails at every boot; disable it, we only need the dhcpd binary.
if [ "$1" = "configure" ] && command -v systemctl >/dev/null 2>&1; then
    systemctl disable --now isc-dhcp-server.service 2>/dev/null || true
fi

# r7: make the systemd journal persistent (survive reboots/crashes).
#
# WHY: the base image ships /usr/lib/systemd/journald.conf.d/10-journald-
# volatile.conf (Storage=volatile, "non-development installations do not
# store logs, to avoid disk wear"), so journald only ever wrote to tmpfs
# (/run/log/journal). Any boot that crashed or was power-cycled before we
# could pull logs over SSH lost everything from that boot - including a
# fresh-flash first-boot hang with a totally black/unresponsive screen that
# we could not diagnose afterward (2026-08-08). Force Storage=persistent so
# every boot's journal lands in /var/log/journal and survives past a crash
# or reboot; flush the current runtime journal to disk immediately so this
# takes effect without waiting for the next journald restart.
if [ "$1" = "configure" ] && command -v journalctl >/dev/null 2>&1; then
    journalctl --flush 2>/dev/null || true
fi

# r7-server: SSH access is key + TOTP, no password auth at all.
#
# /etc/pam.d/sshd is a conffile of openssh-server (dpkg -S confirms it);
# /etc/ssh/sshd_config isn't tracked by dpkg on this image at all, but
# treated the same way regardless — same reasoning as the droidian-camera.conf
# patch above: sparse/ can't ship either path without dpkg refusing to
# overwrite (or, for sshd_config, without clobbering whatever generated it).
# Patch in place instead, idempotently (grep-guarded, safe to run on every
# package upgrade, not just first install).
#
# pam.d/sshd: swap @include common-auth (password check) for
# pam_google_authenticator.so. `nullok` is required, not optional here: it's
# what lets a brand new device boot without a chicken-and-egg lockout before
# anyone has run `google-authenticator` yet. Once a user creates
# ~/.google_authenticator, PAM starts requiring a valid code from them
# specifically — nullok only bypasses the check when no secret file exists.
if [ "$1" = "configure" ] && [ -f /etc/pam.d/sshd ]; then
    if ! grep -q "pam_google_authenticator.so" /etc/pam.d/sshd; then
        sed -i 's/^@include common-auth/#&\nauth       required     pam_google_authenticator.so nullok/' /etc/pam.d/sshd
    fi
fi

# sshd_config: enable keyboard-interactive (carries the TOTP prompt), turn
# off password auth explicitly (don't rely on the commented-out default),
# and require both factors together rather than either one alone.
if [ "$1" = "configure" ] && [ -f /etc/ssh/sshd_config ]; then
    sed -i \
        -e 's/^KbdInteractiveAuthentication no/KbdInteractiveAuthentication yes/' \
        -e 's/^#\?PasswordAuthentication .*/PasswordAuthentication no/' \
        /etc/ssh/sshd_config
    if ! grep -q "^AuthenticationMethods" /etc/ssh/sshd_config; then
        echo "AuthenticationMethods publickey,keyboard-interactive" >> /etc/ssh/sshd_config
    fi
fi

# r7-server: authorize the owner's key for the droidian user (the same
# account phoc-console.service runs as, so local console + SSH share one
# identity). Public key only, safe to keep in source — this is the client
# key's public half, not a secret, and can authenticate against any number
# of the owner's own machines the same way.
if [ "$1" = "configure" ] && [ -d /home/droidian ]; then
    install -d -m 700 -o droidian -g droidian /home/droidian/.ssh
    key="ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIGyYgWD+JPF/1V5s8EqNPCZa1Sn0lw9ZMouXlZf+nW6a vkey"
    touch /home/droidian/.ssh/authorized_keys
    grep -qxF "${key}" /home/droidian/.ssh/authorized_keys || echo "${key}" >> /home/droidian/.ssh/authorized_keys
    chmod 600 /home/droidian/.ssh/authorized_keys
    chown droidian:droidian /home/droidian/.ssh/authorized_keys
fi

# r7-server: stop the Android-side HAL/app services this image doesn't use
# (camera, biometrics, NFC, media framework, telephony, GNSS) - see
# usr/libexec/r7-disable-android-services for the full list and the
# start-then-stop limitation this has until a kernel-level pass removes
# the drivers outright.
if [ "$1" = "configure" ] && command -v systemctl >/dev/null 2>&1; then
    systemctl enable r7-disable-android-services.service || true
fi

#DEBHELPER#

exit 0
