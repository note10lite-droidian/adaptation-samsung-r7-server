# Android binder devices: the HIDL HALs (gralloc, hwcomposer) talk over
# hwbinder. phoc/phosh run as a non-root user (droidian), so these nodes have
# to be reachable by that user. On real Android ueventd already makes them
# 0666; on Droidian udev has to do it.
KERNEL=="binder",    MODE="0666"
KERNEL=="hwbinder",  MODE="0666"
KERNEL=="vndbinder", MODE="0666"

# Separate binder nodes for Waydroid (kernel: CONFIG_ANDROID_BINDER_DEVICES).
# The Halium container keeps the original three; Waydroid takes these.
KERNEL=="anbox-binder",    MODE="0666"
KERNEL=="anbox-hwbinder",  MODE="0666"
KERNEL=="anbox-vndbinder", MODE="0666"
