{
  "layer": "top",
  "position": "bottom",
  // margin-left/right, not CSS padding on window#waybar: GTK padding does
  // NOT shift a wlr-layer-shell surface at all (confirmed live - the bar
  // stayed flush against the edge). These are waybar's own native keys and
  // they do work. Both sides are inset so the bar - and especially the
  // rightmost K (on-screen-keyboard) button - clears this panel's rounded
  // corners, which otherwise cut the button off and made it untappable.
  "margin-left": 12,
  "margin-right": 12,
  "modules-left": ["group/status"],
  "modules-right": ["custom/kbtoggle"],
  "group/status": {
    "orientation": "vertical",
    "modules": ["group/line1", "group/line2"]
  },
  "group/line1": {
    "orientation": "horizontal",
    "modules": ["clock", "custom/battery", "custom/network"]
  },
  "group/line2": {
    "orientation": "horizontal",
    "modules": ["cpu", "memory"]
  },
  "clock": { "format": "<span color='#d0d0d0'>{:%H:%M}</span>" },
  "custom/battery": {
    "exec": "/usr/libexec/r7-battery-status",
    "interval": 1,
    "format": "{}",
    "tooltip": false
  },
  "custom/network": {
    "exec": "/usr/libexec/r7-network-status",
    "interval": 1,
    "format": "{}",
    "tooltip": false
  },
  "custom/kbtoggle": {
    "format": "K",
    "on-click": "/usr/libexec/r7-osk-toggle",
    "tooltip": false
  },
  "cpu": { "format": "<span color='#888888'>C:</span><span color='#d0d0d0'>{usage}%</span>", "interval": 1 },
  "memory": { "format": "<span color='#888888'>M:</span> <span color='#d0d0d0'>{used:0.1f}/{total:0.1f}G</span>", "interval": 1 }
}
