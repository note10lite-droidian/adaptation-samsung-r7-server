# GERCEK SES — hidl_compat kopru modulu
# Samsung Android 13 te ses HAL i yalnizca binderized sunuluyor;
# PA nin bekledigi passthrough HAL (audio.primary.default.so) 11 KB saplama.
# audio.hidl_compat.default.so libaudiohal uzerinden binder servisine konusuyor.
# Sart: android.hardware.audio.service calisiyor olmali (GSI init.disabled.rc kapatiyor).
load-module module-droid-card module_id=hidl_compat config=/etc/pulse/droid/audio_policy_configuration.xml rate=48000
load-module module-native-protocol-unix
load-module module-dbus-protocol
load-module module-default-device-restore
load-module module-always-sink
load-module module-stream-restore

# MIKROFON: droid-source.c kaynagi suspend_cause=PA_SUSPEND_IDLE ile olusturuyor
# (droid-sink.c bunu YAPMIYOR — hoparlorun calisip mikrofonun calismamasinin sebebi).
# Bu sebebi temizleyen tek modul budur; yuklenmezse kaynak kalici askida kalir
# ve kayit 0 bayt uretir.
load-module module-suspend-on-idle
