[Unit]
Description=Samsung Android audio HAL (binderized)
# GSI init.disabled.rc bu servisi _DISABLED yaparak kapatiyor; elle baslatiyoruz.
# PulseAudio module-droid-card + module_id=hidl_compat bu servise binder
# uzerinden konusur (audio.hidl_compat.default.so -> libaudiohal -> IDevicesFactory).
After=lxc@android.service
Requires=lxc@android.service

[Service]
Type=simple
ExecStart=/usr/bin/lxc-attach -n android -- /vendor/bin/hw/android.hardware.audio.service
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
