[Unit]
Description=Remap volume buttons to backlight brightness (r7-server)
# No PulseAudio/gsd-media-keys in this headless console to consume the
# volume keys otherwise - confirmed live they do nothing without this.
After=multi-user.target

[Service]
Type=simple
ExecStart=/usr/libexec/r7-volume-to-brightness
Restart=always
RestartSec=2

[Install]
WantedBy=multi-user.target
