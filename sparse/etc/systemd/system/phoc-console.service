[Unit]
Description=phoc console session (r7-server)
# Seat/VT setup modelled on phosh.service. r7-server: this is the DEFAULT and
# ONLY session (phosh isn't in this image at all) - enabled at boot, replaces
# wayfire-test.service (dropped 2026-08-11: wayfire's own xdg-shell/layer-
# shell surface lifecycle handling is broken on this wlroots 0.18 backport -
# both kinds of surface are born "uninitialized," so focus routing never
# reaches any client and touch lands nowhere. phoc doesn't have this bug -
# it's the exact compositor phosh itself runs on this device every day, with
# real, working touch - so it hosts foot directly instead).
Conflicts=phosh.service getty@tty7.service
After=getty@tty7.service rc-local.service systemd-user-sessions.service
After=lxc@android.service
OnFailure=getty@tty1.service
Before=graphical.target
ConditionPathExists=/dev/tty0
# No session fallback by design (user decision): if the console dies, restart
# it, forever. StartLimitIntervalSec=0 disables systemd's default rate
# limiter (5 starts / 10s, after which it would give up permanently and
# leave the device with no session at all).
StartLimitIntervalSec=0

[Service]
Environment=LANG=C.UTF-8
Environment=XDG_CURRENT_DESKTOP=phoc-console
Environment=XDG_SESSION_DESKTOP=phoc-console
Environment=XDG_SESSION_TYPE=wayland
# Same env phosh.service uses to get wlroots on the hwcomposer backend
# (20-wlroots-hwc-env.conf drop-in) - proven live 2026-08-11.
Environment=WLR_BACKENDS=hwcomposer,libinput
Environment=EGL_PLATFORM=hwcomposer
Environment=WLR_HWC_SKIP_VERSION_CHECK=1
Environment=WLR_HWC_IDLE_TIME=12
# Our OWN phoc.ini (/etc/phoc/phoc.ini, shipped by this package). It used to
# point at /usr/share/phosh/phoc.ini, but that file belongs to the phosh
# package, which the gsi_base edition does not install - phoc was silently
# running on built-in defaults, which is what made the console unreadably
# small. See the config file itself for the scale rationale.
# -E takes exactly one command; r7-console-session is the wrapper that also
# backgrounds waybar (phoc.ini has no [autostart] section like wayfire.ini did).
# Android's own graphics HAL (vendor.hwcomposer-2-2) doesn't reliably finish
# registering before this unit's first start attempt - observed live
# 2026-08-12 on a genuinely fresh flash: phoc started, ran, but never created
# its Wayland socket because the HWC HAL wasn't there yet, and phoc doesn't
# retry internally. Force a fresh HAL restart immediately before every
# attempt (not just the first) rather than depending on some other unit's
# completion signal, since android_boot_completed.service was also observed
# to not reliably predict HAL readiness. "-+" ignores failure (still try to
# start phoc even if setprop errors) and runs as root regardless of this
# unit's own User=, matching the ExecStartPost chvt line below. Combined with
# Restart=always/RestartSec=2, even a losing first race self-heals within
# seconds instead of leaving a dead session forever.
ExecStartPre=-+/usr/bin/setprop ctl.restart vendor.hwcomposer-2-2
ExecStartPre=/bin/sleep 2
ExecStart=/usr/bin/phoc -C /etc/phoc/phoc.ini -E /usr/libexec/r7-console-session
# Activate the VT so the logind session becomes active on seat0 (phosh does chvt 7).
ExecStartPost=+chvt 7
TimeoutStartSec=30
User=droidian
PAMName=login
WorkingDirectory=~
Restart=always
RestartSec=2
TTYPath=/dev/tty7
TTYReset=yes
TTYVHangup=yes
TTYVTDisallocate=yes
StandardInput=tty-fail
StandardOutput=journal
StandardError=journal
UtmpIdentifier=tty7
UtmpMode=user

[Install]
WantedBy=graphical.target
