#!/bin/sh
# r7-server: patch conffiles owned by OTHER packages (openssh-server, ufw,
# droidian-camera) that adaptation-samsung-r7-configs's postinst used to
# patch directly, guarded only by `[ -f ... ]`.
#
# WHY THIS MOVED HERE: on a real image build, apt's install order inside the
# SAME transaction is not guaranteed to configure openssh-server (which
# creates /etc/ssh/sshd_config and /etc/pam.d/sshd) before
# adaptation-samsung-r7-configs's own postinst runs. When that happens the
# `[ -f ... ]` guards evaluate false and the whole block is skipped - GRACEFULLY
# skipped, no error, no warning. Confirmed live 2026-08-12 on a genuinely fresh
# flash: both files still carried their original packaged mtime, meaning the
# SSH hardening (password auth off, TOTP required) had SILENTLY NEVER APPLIED,
# leaving default OpenSSH password auth live and reachable over USB RNDIS with
# the well-known default password from the public install docs. Running this
# at actual boot time instead sidesteps the race entirely: by the time ANY
# systemd unit runs on a booting system, every package from the image build is
# already fully unpacked, so these files are guaranteed to exist. Same
# reasoning r7-regenerate-ssh-host-keys.service already relies on.
#
# Every patch below is grep-guarded (safe/idempotent to rerun every boot),
# so unlike the SSH host keys this isn't gated behind a one-time stamp file -
# if a future package upgrade ever resets one of these conffiles to its
# default, this just reapplies the patch on the next boot.
set -eu

changed=0

# SSH hardening (password auth off, publickey-only, TOTP via PAM) used to
# live here and was REMOVED (2026-08-13, user decision): it locked the
# owner out of their own device (see the now-deleted TEMPORARY note this
# block used to carry, from the 2026-08-12 lockout) and conflicts with the
# project's raspi-config-style onboarding model, where SSH must work with
# the documented default password out of the box. If SSH hardening is
# wanted again later, it belongs in an opt-in droidian-config module, not
# forced unconditionally on every boot.

# Camera backend: droidian-camera defaults to "aal", broken on this device.
CAMCONF=/etc/droidian-camera.conf
if [ -f "$CAMCONF" ] && grep -q '^backend=aal' "$CAMCONF"; then
    sed -i 's/^backend=aal/backend=gst/' "$CAMCONF"
fi

# ufw: this kernel lacks the ip6t_rt/xt_rt netfilter match module that
# before6.rules' RH0 rule needs - see the original postinst comment history
# for the full root-cause writeup. RH0 has been disabled by the kernel's own
# IPv6 stack by default since ~2009 regardless, so this is redundant
# defense-in-depth, not a load-bearing control.
if [ -f /etc/ufw/before6.rules ]; then
    sed -i '/-m rt --rt-type 0/s/^-A/#-A/' /etc/ufw/before6.rules
fi

# lxc-net.service: the `lxc` package's generic lxcbr0 NAT-bridge setup.
# Fails on this device anyway (kernel has no MASQUERADE netfilter target -
# not a routing/gateway kernel), but that's moot: the android LXC container
# has zero `lxc.network.*` directives in its config (it shares the host
# network namespace directly - RNDIS/WiFi are host interfaces), so nothing
# on this device was ever going to use lxcbr0. Confirmed live 2026-08-13 -
# see GUNLUK.md. Flip the package default off instead of just masking the
# failing unit, so it stops trying at all.
LXCNETDEF=/etc/default/lxc-net
if [ -f "$LXCNETDEF" ] && grep -q '^USE_LXC_BRIDGE="true"' "$LXCNETDEF"; then
    sed -i 's/^USE_LXC_BRIDGE="true"/USE_LXC_BRIDGE="false"/' "$LXCNETDEF"
fi
if command -v systemctl >/dev/null 2>&1; then
    systemctl disable --now lxc-net.service 2>/dev/null || true
fi

# --no-block is required, not optional: this unit is Before=ssh.service
# (so patches apply before ssh's first activation this boot), which means
# ssh.service can't reach "active" until THIS unit's start job finishes.
# A blocking `systemctl restart ssh` here would wait for ssh to become
# active while ssh is simultaneously waiting for this unit to finish -
# a guaranteed deadlock, confirmed live 2026-08-12 (ssh never came up at
# all). On first boot this restart is redundant anyway (Before= already
# guarantees clean config on ssh's first start) - it only matters for a
# later boot where a package upgrade reset a conffile after ssh was
# already active, and --no-block handles that without risking the same
# deadlock even if ordering ever changes.
if [ "$changed" = 1 ] && command -v systemctl >/dev/null 2>&1; then
    systemctl restart --no-block ssh 2>/dev/null || true
fi
