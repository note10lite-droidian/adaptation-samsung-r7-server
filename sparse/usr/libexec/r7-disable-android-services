#!/bin/bash
# r7-server: stop the handful of Android-side services that CANNOT be
# removed at the kernel level.
#
# READ THIS BEFORE ADDING ANYTHING HERE. This script is a last resort, not
# the normal way to get rid of an unwanted Android service. It is
# start-then-stop: the service is briefly live before being killed, because
# these start from stock Android .rc triggers baked into the vendor/system
# partitions, which this project does not rebuild. That is strictly worse
# than the service not existing, and it has already bitten us once - on a
# fresh flash 2026-08-12 ril-daemon started after the watch window had
# closed and pinned ~90% of a CPU core for the whole session.
#
# The correct fix for anything driver-backed is to REMOVE THE KERNEL DRIVER
# (arch/arm64/configs/exynos9810-r7_halium_defconfig on the kernel's
# r7-server branch). With no driver there is no startup window at all:
# Android's init may still try to launch the service, but it has nothing to
# bind to. That pass has been done for telephony/CP, GNSS, NFC,
# fingerprint, camera, hardware video codecs, and the vibrator - all of
# which USED to be listed here and are now gone from this file entirely.
#
# What is left below is only what has no kernel driver to remove:
#
#   - gatekeeperd, vendor.gatekeeper-1-0, vaultkeeper, vaultkeeper_hal:
#     TEE-backed (Samsung TEEGRIS). They talk to the secure world through
#     /dev/tzic, not to a strippable device driver. Removing TEEGRIS access
#     outright is a separate, riskier question (the Android container's own
#     init expects it) and is deliberately not attempted here.
#   - media.swcodec, mediaextractor, mediametrics, minimedia,
#     samsung-software-media-c2-hal-1-0: SOFTWARE media framework services.
#     They need no hardware at all, so stripping the MFC/SMFC codec drivers
#     (already done) does not stop them starting.
#   - vendor.samsung.hardware.light-default: the Android light HAL. The
#     backlight driver itself is deliberately KEPT (the console needs it,
#     and r7-hw-buttons drives it directly through
#     /sys/class/backlight/panel), so there is no driver to remove here -
#     only this unused Android-side consumer of it.
#
# If you are about to add a line here, first check whether the thing is
# driver-backed. If it is, strip the driver instead.

SERVICES="
gatekeeperd
vendor.gatekeeper-1-0
vaultkeeper
vaultkeeper_hal
media.swcodec
mediaextractor
mediametrics
minimedia
samsung-software-media-c2-hal-1-0
vendor.samsung.hardware.light-default
"

# 300s, not the original 40s: on a genuinely fresh flash 2026-08-12,
# ril-daemon started after the old 40s window had already given up watching
# for it, so it ran unimpeded (pinning ~90% of a CPU core) for the rest of
# that boot. Widened rather than made unbounded, to stay a self-terminating
# script rather than a permanent daemon.
remaining="$SERVICES"
for i in $(seq 1 300); do
    still=""
    for svc in $remaining; do
        state=$(lxc-attach -n android -- getprop init.svc.$svc 2>/dev/null)
        case "$state" in
            running)
                lxc-attach -n android -- setprop ctl.stop "$svc" 2>/dev/null
                ;;
            stopped)
                # already stopped (e.g. sim_config/ril-daemon are often
                # stopped before this even runs) - nothing to do
                ;;
            *)
                # property not observed yet - service hasn't started, keep
                # watching for it within the bounded wait window
                still="$still $svc"
                ;;
        esac
    done
    remaining="$still"
    [ -z "$remaining" ] && break
    sleep 1
done
exit 0
