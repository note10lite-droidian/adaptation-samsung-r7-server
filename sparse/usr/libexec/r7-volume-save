#!/bin/sh
# SPDX-License-Identifier: GPL-2.0-only
# r7: persist sink volume changes across PulseAudio restarts/reboots.
# See r7-volume-restore for why this is needed (module-stream-restore never
# tracks sink device volume, only per-app stream volume).

STATE_DIR="$HOME/.local/state"
STATE="$STATE_DIR/r7-volume"
mkdir -p "$STATE_DIR"

save_volume() {
    vol="$(pactl list sinks 2>/dev/null | awk '
        /Name: sink\.primary-out/ { f = 1 }
        f && /Volume:/ {
            match($0, /[0-9]+%/)
            print substr($0, RSTART, RLENGTH - 1)
            exit
        }
    ')"
    [ -n "$vol" ] && echo "$vol" > "$STATE"
}

# Prime the state file on start so a fresh install has something sane before
# the first volume change.
save_volume

pactl subscribe 2>/dev/null | while read -r line; do
    case "$line" in
        *"'change' on sink"*) save_volume ;;
    esac
done
