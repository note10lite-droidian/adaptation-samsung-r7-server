#!/usr/bin/env python3
# r7-server: no PulseAudio/gsd-media-keys volume-key handling, and no
# power-key/screen-blank/idle-timeout handling either, in this headless
# console - nothing else consumes gpio_keys' events or watches for
# inactivity. Volume remaps to backlight brightness; power toggles the
# panel off/on via phoc's own wlr-output-power-management-v1 support
# (confirmed live 2026-08-11: decon-0 actually disables/re-enables, a
# real panel power-state change, not just a black frame). Idle timeout
# auto-triggers the same panel-off after IDLE_TIMEOUT seconds of no
# touch/button activity.
#
# Touch only resets the idle timer while the display is already ON - it
# deliberately does NOT wake the display back up, matching normal phone
# behaviour (only the power button wakes a screen-off device; touching
# it while off does nothing). Brightness itself needs no extra "memory"
# handling: confirmed live it's untouched by a decon power-mode cycle,
# and systemd-backlight@backlight:panel.service already persists it
# across reboots.
#
# Resolves devices by name, not hardcoded /dev/input/eventN paths, since
# event numbering isn't guaranteed stable across boots (probe order)
# even though they were event6/event7 on this device when checked live.
import evdev
import select
import subprocess
import time

BACKLIGHT = "/sys/class/backlight/panel"
STEP = 30
OUTPUT = "HWCOMPOSER-1"
WAYLAND_USER = "droidian"
WAYLAND_ENV = {"XDG_RUNTIME_DIR": "/run/user/32011", "WAYLAND_DISPLAY": "wayland-0"}
IDLE_TIMEOUT = 120
POLL_SECONDS = 5


def read_int(path):
    with open(path) as f:
        return int(f.read().strip())


def write_int(path, val):
    with open(path, "w") as f:
        f.write(str(val))


def find_device(name):
    for path in evdev.list_devices():
        dev = evdev.InputDevice(path)
        if dev.name == name:
            return dev
    raise RuntimeError(f"{name} input device not found")


def set_display(state):
    env_args = [f"{k}={v}" for k, v in WAYLAND_ENV.items()]
    subprocess.run(
        ["su", "-", WAYLAND_USER, "-c",
         "env " + " ".join(env_args) + f" wlopm --{state} {OUTPUT}"],
        timeout=5,
    )


def main():
    max_b = read_int(f"{BACKLIGHT}/max_brightness")
    keys_dev = find_device("gpio_keys")
    touch_dev = find_device("sec_touchscreen")
    devices = {keys_dev.fd: keys_dev, touch_dev.fd: touch_dev}

    display_on = True
    last_activity = time.monotonic()

    while True:
        ready, _, _ = select.select(devices, [], [], POLL_SECONDS)
        now = time.monotonic()

        if ready:
            for fd in ready:
                dev = devices[fd]
                for event in dev.read():
                    if dev is keys_dev and event.type == evdev.ecodes.EV_KEY and event.value == 1:
                        if event.code == evdev.ecodes.KEY_POWER:
                            display_on = not display_on
                            set_display("on" if display_on else "off")
                            last_activity = now
                        elif event.code == evdev.ecodes.KEY_VOLUMEUP:
                            cur = read_int(f"{BACKLIGHT}/brightness")
                            write_int(f"{BACKLIGHT}/brightness", min(max_b, cur + STEP))
                            if display_on:
                                last_activity = now
                        elif event.code == evdev.ecodes.KEY_VOLUMEDOWN:
                            cur = read_int(f"{BACKLIGHT}/brightness")
                            write_int(f"{BACKLIGHT}/brightness", max(0, cur - STEP))
                            if display_on:
                                last_activity = now
                    elif dev is touch_dev and display_on:
                        last_activity = now
        else:
            if display_on and (now - last_activity) >= IDLE_TIMEOUT:
                set_display("off")
                display_on = False


if __name__ == "__main__":
    main()
