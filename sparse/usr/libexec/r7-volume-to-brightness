#!/usr/bin/env python3
# r7-server: no PulseAudio/gsd-media-keys volume-key handling in this
# headless console (no phosh, nothing else consumes gpio_keys' volume
# events either), so remap them to backlight brightness instead - useful
# physical control without needing to reach the touchscreen. Confirmed
# live 2026-08-11 the volume keys otherwise do nothing in this session,
# so no exclusive grab is needed - nothing else is listening on event6.
import evdev

BACKLIGHT = "/sys/class/backlight/panel"
STEP = 30


def read_int(path):
    with open(path) as f:
        return int(f.read().strip())


def write_int(path, val):
    with open(path, "w") as f:
        f.write(str(val))


def find_gpio_keys():
    # event numbering isn't guaranteed stable across boots (probe order),
    # unlike the sysfs device name - resolve by name instead of hardcoding
    # a path (confirmed live 2026-08-11 as event6, but don't rely on that).
    for path in evdev.list_devices():
        dev = evdev.InputDevice(path)
        if dev.name == "gpio_keys":
            return dev
    raise RuntimeError("gpio_keys input device not found")


def main():
    max_b = read_int(f"{BACKLIGHT}/max_brightness")
    dev = find_gpio_keys()
    for event in dev.read_loop():
        if event.type != evdev.ecodes.EV_KEY or event.value != 1:
            continue
        cur = read_int(f"{BACKLIGHT}/brightness")
        if event.code == evdev.ecodes.KEY_VOLUMEUP:
            write_int(f"{BACKLIGHT}/brightness", min(max_b, cur + STEP))
        elif event.code == evdev.ecodes.KEY_VOLUMEDOWN:
            write_int(f"{BACKLIGHT}/brightness", max(0, cur - STEP))


if __name__ == "__main__":
    main()
