#!/bin/sh
# r7-server: toggle phosh-osk-stub's visibility via its sm.puri.OSK0 DBus
# interface. foot (a terminal) doesn't do text-input-v3 field-focus like
# GTK apps do, so the OSK never auto-shows for it - a manual waybar
# button is the deliberate replacement for that automatic behavior.
current="$(gdbus call --session --dest sm.puri.OSK0 --object-path /sm/puri/OSK0 \
    --method org.freedesktop.DBus.Properties.Get sm.puri.OSK0 Visible 2>/dev/null)"
case "$current" in
    *true*) new=false ;;
    *) new=true ;;
esac
gdbus call --session --dest sm.puri.OSK0 --object-path /sm/puri/OSK0 \
    --method sm.puri.OSK0.SetVisible "$new" >/dev/null 2>&1
