#!/bin/bash
# r7-server: runs as root (via a narrowly-scoped sudo rule for droidian -
# see the r7-console-login sudoers.d drop-in). Verifies credentials via
# pamtester (PAM authenticate only, no tty/session ownership), then hands
# off via `su -` - run by root, su never re-prompts and (unlike /bin/login)
# doesn't do vhangup()/session-leader tricks, which crashed the whole
# compositor session when tried nested inside a Wayland pty (confirmed
# live 2026-08-11).
#
# Deliberately NOT `exec su -`: the idle timeout (TMOUT, set for console
# sessions only in /etc/profile.d/r7-console-idle-timeout.sh) works by
# bash exiting itself when idle at the prompt. Without exec, this script
# is still alive underneath when that happens (or on a normal `exit`) and
# the while loop below just re-prompts - a lightweight return to the
# login prompt, not a full phoc/waybar/OSK session restart.
read_password() {
    local pass="" char
    while IFS= read -r -s -n1 char; do
        if [ -z "$char" ]; then
            break
        elif [[ "$char" == $'\x7f' ]]; then
            if [ -n "$pass" ]; then
                pass="${pass%?}"
                printf '\b \b'
            fi
        else
            pass+="$char"
            printf '*'
        fi
    done
    password="$pass"
}

while true; do
    # Defensive: whatever ran in the previous session (or the TMOUT
    # kill itself, via the SIGHUP it sends the foreground job) may have
    # left this tty in a broken state -- e.g. non-blocking raw mode,
    # which turns the read below into a tight empty-read spin that
    # floods the screen with this prompt instead of waiting for real
    # input. Confirmed live as the root cause of exactly that symptom
    # with pcs-health before it trapped HUP. Reset unconditionally so
    # this loop can't be taken down by a future program's bug either.
    stty sane 2>/dev/null
    printf 'r7 console login: '
    read -r username
    [ -n "$username" ] || continue
    printf 'Password: '
    read_password
    printf '\n'
    if printf '%s' "$password" | pamtester login "$username" authenticate >/dev/null 2>&1; then
        unset password
        su - "$username"
        printf '\n'
        continue
    fi
    unset password
    printf 'Authentication failed\n\n'
done
