 void ThumbnailGenerator::processFrame(const QVideoFrame &frame) {
     if (frame.isValid()) {
+        // r7: ilk kare(ler) siyah olabiliyor (kamera/encoder isinmasi) -> thumbnail
+        // siyah cikiyordu. Biraz ileriden kare al: pozisyon >=500ms VEYA guvenlik
+        // icin >=15 kare gorulunce. Yoksa erken kareyi atla, oynatma devam etsin.
+        ++m_framesSeen;
+        if (m_mediaPlayer.position() < 500 && m_framesSeen < 15) {
+            return;
+        }
         QVideoFrame cloneFrame(frame);
-        cloneFrame.map(QAbstractVideoBuffer::ReadOnly);
-        QImage image(cloneFrame.bits(),
-                     cloneFrame.width(),
-                     cloneFrame.height(),
-                     QVideoFrame::imageFormatFromPixelFormat(cloneFrame.pixelFormat()));
-        emit thumbnailGenerated(image);
-        m_mediaPlayer.stop();
-        cloneFrame.unmap();
+        // r7: eski kod manuel bits()+imageFormatFromPixelFormat kullaniyordu; decode
+        // edilen kare YUV oldugunda imageFormatFromPixelFormat Format_Invalid donuyor
+        // -> QImage bos/siyah. QVideoFrame::image() (capturefilter'in kullandigi, foto
+        // renkli calisiyor) YUV->RGB donusumunu dogru yapar.
+        QImage image = cloneFrame.image();
+        if (!image.isNull()) {
+            emit thumbnailGenerated(image);
+            m_mediaPlayer.stop();
+        }
     }
 }
