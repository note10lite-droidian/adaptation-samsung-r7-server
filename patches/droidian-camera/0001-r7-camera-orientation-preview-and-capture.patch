 void FileManager::removeGStreamerCacheDirectory() {
     QString homePath = QStandardPaths::writableLocation(QStandardPaths::HomeLocation);
     QString filePath = homePath + "/.cache/gstreamer-1.0/registry.aarch64.bin";
