 }
@@ -27,14 +28,22 @@ QString ThumbnailGenerator::toQmlImage(const QImage &image) {
 
 void ThumbnailGenerator::processFrame(const QVideoFrame &frame) {
     if (frame.isValid()) {
+        // The first frame(s) can be black while the camera/encoder warms up, so
+        // the thumbnail came out black. Take a frame slightly later: position
+        // >=500 ms, or >=15 frames seen as a safety net. Skip earlier ones.
+        ++m_framesSeen;
+        if (m_mediaPlayer.position() < 500 && m_framesSeen < 15) {
+            return;
+        }
         QVideoFrame cloneFrame(frame);
-        cloneFrame.map(QAbstractVideoBuffer::ReadOnly);
-        QImage image(cloneFrame.bits(),
-                     cloneFrame.width(),
-                     cloneFrame.height(),
-                     QVideoFrame::imageFormatFromPixelFormat(cloneFrame.pixelFormat()));
-        emit thumbnailGenerated(image);
-        m_mediaPlayer.stop();
-        cloneFrame.unmap();
+        // The old code used bits()+imageFormatFromPixelFormat manually. When the
+        // decoded frame is YUV, imageFormatFromPixelFormat returns Format_Invalid
+        // and the QImage comes out empty/black. QVideoFrame::image() - the same
+        // call CaptureFilter uses, where colour works - converts YUV->RGB properly.
+        QImage image = cloneFrame.image();
+        if (!image.isNull()) {
+            emit thumbnailGenerated(image);
+            m_mediaPlayer.stop();
+        }
     }
 }
