+// Creates an absolute path as given, with no home prefix. The video recording
+// directory is derived from the same MoviesLocation as outputPath, so filesink
+// always writes somewhere that exists - a missing directory caused black recordings.
+void FileManager::createDirectoryAbsolute(const QString &path) {
+    QDir dir;
+    if (!path.isEmpty() && !dir.exists(path)) {
+        dir.mkpath(path);
+    }
+}
