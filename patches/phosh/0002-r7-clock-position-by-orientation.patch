-                      <object class="GtkLabel" id="lbl_clock">
-                        <property name="visible">1</property>
-                        <property name="margin-top">2</property>
-                        <property name="label">00:00</property>
-                        <style>
-                          <class name="phosh-topbar-clock"/>
-                        </style>
-                      </object>
-                    </child>
                     <child>
                       <object class="GtkBox" id="box_indicators">
                         <property name="visible">1</property>
@@ -322,6 +312,23 @@
                                 <property name="child">location_info</property>
                               </object>
                             </child>
+                            <!-- r7: saat buraya, pil ikonunun hemen soluna
+                                 eklendi (m.20). status_icons_box hexpand=1
+                                 + kendi ic "align=end" mantigiyla saga
+                                 yasliyor; saat box_top_bar'da AYRI bir
+                                 kardes olsaydi bu genislemeye katilmiyor,
+                                 solda dogal boyutunda kalip pilden kopuk
+                                 gorunuyordu. GUNLUK G26.6. -->
+                            <child>
+                              <object class="GtkLabel" id="lbl_clock">
+                                <property name="visible">1</property>
+                                <property name="margin-top">2</property>
+                                <property name="label">00:00</property>
