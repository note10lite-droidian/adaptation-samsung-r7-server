Description: Position the status bar clock by orientation, clear of the punch-hole camera
 On this device (SM-N770F, front camera in a top-centre punch-hole) there is no
 matching display-panel in gmobile - the device-tree compatible strings
 ("samsung,armv8" / "samsung,exynos9810") are too generic to identify the model.
 Upstream's cutout-aware clock placement (PhoshLayoutManager->panel/get_clock_pos
 in layout-manager.c) therefore never runs, and the clock stayed centred, right
 underneath the camera.
 .
 Rather than reworking upstream's cutout mechanism - pointless without the exact
 cutout geometry - this places the clock directly in status_icons_box in the .ui
 file, immediately left of the battery icon (the portrait/default case), and in
 top-panel.c moves it to the centre of box_top_bar in landscape, keyed off the
 PhoshMonitor transform. The transform is used rather than the panel width
 because width is unreliable here, thanks to the device's scale/ppi calculation.
 .
 PhoshStatusIconsBox is a custom GtkContainer (GPtrArray backed; append always
 prepends at index 0, and each child is wrapped in a GtkRevealer), so ordering
 and ancestor checks are handled accordingly - see the comments in the diff.
Author: Yunus Tan <yunus.tan@outlook.com.tr>
Origin: downstream, r7 (SM-N770F) Droidian port
Forwarded: no
Last-Update: 2026-07-27
---
diff --git a/src/ui/top-panel.ui b/src/ui/top-panel.ui
index 2b45e03..15ed354 100644
--- a/src/ui/top-panel.ui
+++ b/src/ui/top-panel.ui
@@ -266,16 +266,6 @@
                       </object>
                       <!-- box_network -->
                     </child>
-                    <child type="center">
-                      <object class="GtkLabel" id="lbl_clock">
-                        <property name="visible">1</property>
-                        <property name="margin-top">2</property>
-                        <property name="label">00:00</property>
-                        <style>
-                          <class name="phosh-topbar-clock"/>
-                        </style>
-                      </object>
-                    </child>
                     <child>
                       <object class="GtkBox" id="box_indicators">
                         <property name="visible">1</property>
@@ -322,6 +312,23 @@
                                 <property name="child">location_info</property>
                               </object>
                             </child>
+                            <!-- Clock goes here, immediately left of the
+                                 battery icon. status_icons_box has hexpand=1
+                                 and its own internal "align=end" logic, so it
+                                 hugs the right edge; a clock placed as a
+                                 SEPARATE sibling in box_top_bar would not take
+                                 part in that expansion and would sit at its
+                                 natural size on the left, detached. -->
+                            <child>
+                              <object class="GtkLabel" id="lbl_clock">
+                                <property name="visible">1</property>
+                                <property name="margin-top">2</property>
+                                <property name="label">00:00</property>
+                                <style>
+                                  <class name="phosh-topbar-clock"/>
+                                </style>
+                              </object>
+                            </child>
                             <child>
                               <object class="PhoshBatteryInfo" id="batteryinfo">
                                 <property name="visible">1</property>
diff --git a/src/top-panel.c b/src/top-panel.c
index 974e800..18fad9b 100644
--- a/src/top-panel.c
+++ b/src/top-panel.c
@@ -827,6 +827,57 @@ on_configure_event (PhoshTopPanel *self, GdkEventConfigure *event)
 }
 
 
+static void
+reposition_clock (PhoshTopPanel *self)
+{
+  /* gmobile has no matching display-panel for this device (its device-tree
+   * compatible strings are too generic), so upstream's cutout-aware clock
+   * placement in layout-manager.c never runs. In portrait the clock is fixed
+   * inside status_icons_box, immediately left of the battery, placed there in
+   * the .ui file. In landscape the front camera moves to the edge, so the
+   * clock is moved to the centre of box_top_bar. Orientation comes from the
+   * PhoshMonitor transform rather than the panel width, because width is
+   * unreliable here thanks to the device's scale/ppi calculation.
+   *
+   * PhoshStatusIconsBox is a custom GtkContainer (GPtrArray backed; append
+   * always prepends at index 0), so on the way back to portrait the battery
+   * info is re-appended AFTER the clock to preserve ordering - battery at the
+   * edge, clock immediately to its left. */
+  PhoshMonitor *monitor = phosh_shell_get_primary_monitor (phosh_shell_get_default ());
+  gboolean landscape = monitor && phosh_monitor_transform_is_tilted (phosh_monitor_get_transform (monitor));
+  GtkWidget *parent = gtk_widget_get_parent (self->lbl_clock);
+  /* phosh_status_icons_box_append() wraps the child in its own GtkRevealer,
+   * so the DIRECT parent of lbl_clock is that revealer rather than
+   * status_icons_box itself. The "is it inside status_icons_box?" test
+   * therefore has to go through get_ancestor(), stepping over the
+   * wrapper. */
+  gboolean in_status_icons = (gtk_widget_get_ancestor (self->lbl_clock, PHOSH_TYPE_STATUS_ICONS_BOX) ==
+                              GTK_WIDGET (self->status_icons_box));
+
+  if (landscape) {
+    if (!in_status_icons)
+      return;
+
+    g_object_ref (self->lbl_clock);
+    phosh_status_icons_box_remove (self->status_icons_box, self->lbl_clock);
+    gtk_box_set_center_widget (GTK_BOX (self->box_top_bar), self->lbl_clock);
+    g_object_unref (self->lbl_clock);
+  } else {
+    if (parent != self->box_top_bar)
+      return;
+
+    g_object_ref (self->lbl_clock);
+    g_object_ref (self->batteryinfo);
+    gtk_box_set_center_widget (GTK_BOX (self->box_top_bar), NULL);
+    phosh_status_icons_box_remove (self->status_icons_box, self->batteryinfo);
+    phosh_status_icons_box_append (self->status_icons_box, self->lbl_clock);
+    phosh_status_icons_box_append (self->status_icons_box, self->batteryinfo);
+    g_object_unref (self->batteryinfo);
+    g_object_unref (self->lbl_clock);
+  }
+}
+
+
 static void
 phosh_top_panel_configured (PhoshLayerSurface *layer_surface)
 {
@@ -837,6 +888,8 @@ phosh_top_panel_configured (PhoshLayerSurface *layer_surface)
 
   g_debug ("%s: %dx%d", __func__, width, height);
 
+  reposition_clock (PHOSH_TOP_PANEL (layer_surface));
+
   PHOSH_LAYER_SURFACE_CLASS (phosh_top_panel_parent_class)->configured (layer_surface);
 }
 
