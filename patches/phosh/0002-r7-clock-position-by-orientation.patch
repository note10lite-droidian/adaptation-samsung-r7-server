diff --git a/src/top-panel.c b/src/top-panel.c
index 974e800..18fad9b 100644
--- a/src/top-panel.c
+++ b/src/top-panel.c
@@ -827,6 +827,57 @@ on_configure_event (PhoshTopPanel *self, GdkEventConfigure *event)
 }
 
 
+static void
+reposition_clock (PhoshTopPanel *self)
+{
+  /* r7: Bu cihazda gmobile'de eslesen bir display-panel yok (device-tree
+   * compatible stringleri cok jenerik), yani upstream'in cutout-farkinda
+   * saat konumlandirmasi (layout-manager.c) hic calismiyor. Portre modda
+   * saat status_icons_box icinde sabit (pilin hemen solunda, .ui'de
+   * yerlestirildi, dogrulandi). Yatay modda on kamera kenara kaydigindan
+   * saati box_top_bar'in ortasina tasiyoruz. Yon tespiti icin panel
+   * genisligi degil PhoshMonitor transform kullaniliyor (genislik, cihazin
+   * olcek/ppi hesaplamasi yuzunden guvenilir degil).
+   *
+   * PhoshStatusIconsBox kendi ozel GtkContainer'i (GPtrArray tabanli,
+   * append hep index 0'a prepend eder) oldugundan, portre moda donuste
+   * sirayi korumak icin batteryinfo'yu clock'tan SONRA yeniden ekliyoruz;
+   * boylece pil tekrar en kenara, saat hemen soluna gelir. GUNLUK G26.6. */
+  PhoshMonitor *monitor = phosh_shell_get_primary_monitor (phosh_shell_get_default ());
+  gboolean landscape = monitor && phosh_monitor_transform_is_tilted (phosh_monitor_get_transform (monitor));
+  GtkWidget *parent = gtk_widget_get_parent (self->lbl_clock);
+  /* r7: phosh_status_icons_box_append() cocugu kendi ozel GtkRevealer
+   * sarmalayicisina koyuyor, yani lbl_clock'un DOGRUDAN ebeveyni
+   * status_icons_box degil o revealer oluyor - "status_icons_box icinde
+   * mi?" kontrolunu get_ancestor ile (sarmalayiciyi atlayarak) yapmak
+   * gerekiyor. */
+  gboolean in_status_icons = (gtk_widget_get_ancestor (self->lbl_clock, PHOSH_TYPE_STATUS_ICONS_BOX) ==
+                              GTK_WIDGET (self->status_icons_box));
+
+  if (landscape) {
+    if (!in_status_icons)
+      return;
+
+    g_object_ref (self->lbl_clock);
+    phosh_status_icons_box_remove (self->status_icons_box, self->lbl_clock);
+    gtk_box_set_center_widget (GTK_BOX (self->box_top_bar), self->lbl_clock);
+    g_object_unref (self->lbl_clock);
+  } else {
+    if (parent != self->box_top_bar)
+      return;
+
+    g_object_ref (self->lbl_clock);
+    g_object_ref (self->batteryinfo);
+    gtk_box_set_center_widget (GTK_BOX (self->box_top_bar), NULL);
+    phosh_status_icons_box_remove (self->status_icons_box, self->batteryinfo);
+    phosh_status_icons_box_append (self->status_icons_box, self->lbl_clock);
+    phosh_status_icons_box_append (self->status_icons_box, self->batteryinfo);
+    g_object_unref (self->batteryinfo);
+    g_object_unref (self->lbl_clock);
+  }
+}
+
+
 static void
 phosh_top_panel_configured (PhoshLayerSurface *layer_surface)
 {
@@ -837,6 +888,8 @@ phosh_top_panel_configured (PhoshLayerSurface *layer_surface)
 
   g_debug ("%s: %dx%d", __func__, width, height);
 
+  reposition_clock (PHOSH_TOP_PANEL (layer_surface));
+
   PHOSH_LAYER_SURFACE_CLASS (phosh_top_panel_parent_class)->configured (layer_surface);
 }
 
